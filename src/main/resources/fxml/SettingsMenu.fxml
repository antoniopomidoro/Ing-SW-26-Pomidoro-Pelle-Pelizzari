<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.polimi.ingsw.view.gui.SettingsMenuController"
      alignment="CENTER" spacing="16" prefWidth="360" prefHeight="280"
      style="-fx-background-color: rgba(0,0,0,0.92); -fx-padding: 24; -fx-border-color: #555; -fx-border-width: 1;">

    <Label text="Settings" style="-fx-text-fill: white; -fx-font-size: 20;" />

    <CheckBox fx:id="fullscreenCheck" text="Fullscreen" style="-fx-text-fill: white;" />

    <VBox spacing="4">
        <Label text="Music" style="-fx-text-fill: white;" />
        <Slider fx:id="musicSlider" min="0" max="1" majorTickUnit="0.25" blockIncrement="0.05" />
    </VBox>

    <VBox spacing="4">
        <Label text="Sound effects" style="-fx-text-fill: white;" />
        <Slider fx:id="sfxSlider" min="0" max="1" majorTickUnit="0.25" blockIncrement="0.05" />
    </VBox>

    <Button fx:id="closeButton" text="Close" onAction="#onClose" />

</VBox>
